<?xml version="1.0" encoding="UTF-8"?>

<plugin>

   <!--
     Contribute the E4 PartDescriptor via fragment.e4xmi.
     The <e4view> below registers it in the "Show Views" dialog (IViewRegistry),
     but the PartDescriptor is what EPartService.showPart() uses to actually
     instantiate HdViewPart via E4 DI.  Both are required.
   -->
   <extension
         id="me.glindholm.plugin.http4e2.ui.model"
         point="org.eclipse.e4.workbench.model">
      <fragment
            uri="fragment.e4xmi"
            apply="always">
      </fragment>
   </extension>

   <!--
     Register the pure-E4 view in the "Show Views" dialog (Window > Show View > Other...).
   -->
   <extension point="org.eclipse.ui.views">
      <category
            id="me.glindholm.plugin.http4e2.ui.category"
            name="HTTP4e2">
      </category>
      <e4view
            category="me.glindholm.plugin.http4e2.ui.category"
            class="me.glindholm.plugin.http4e2.httpclient.ui.HdViewPart"
            id="me.glindholm.plugin.http4e2.ui.HdViewPart"
            name="HTTP4e2"
            icon="icons/logo.png"
            restorable="true">
      </e4view>
   </extension>

   <!--
     E3 command + handler for the "Window > Show View" submenu entry.
   -->
   <extension point="org.eclipse.ui.commands">
      <command
            id="me.glindholm.plugin.http4e2.ui.command.showView"
            name="HTTP4e2 View"
            description="Open the HTTP4e2 request tool view">
      </command>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler
            commandId="me.glindholm.plugin.http4e2.ui.command.showView"
            class="me.glindholm.plugin.http4e2.httpclient.ui.ShowHttp4e2ViewHandler">
      </handler>
   </extension>

   <extension point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="menu:org.eclipse.ui.window.showView?after=additions">
         <command
               commandId="me.glindholm.plugin.http4e2.ui.command.showView"
               label="HTTP4e2 View"
               icon="icons/logo.png"
               style="push">
         </command>
      </menuContribution>
   </extension>

   <!-- e4 CSS theming -->
   <extension
         point="org.eclipse.e4.ui.css.swt.theme">
       <stylesheet
            uri="css/http4e-default.css">
         <themeid
               refid="org.eclipse.e4.ui.css.theme.e4_default">
         </themeid>
      </stylesheet>
      <stylesheet
            uri="css/http4e-dark.css">
         <themeid
               refid="org.eclipse.e4.ui.css.theme.e4_dark">
         </themeid>
      </stylesheet>
   </extension>
</plugin>