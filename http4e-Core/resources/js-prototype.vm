<script type="module">
  /*
   * This is a sample JavaScript HTTP REST client generated by HTTP4e2,
   * based on the Fetch API (replaces the legacy Prototype.js client).
   */
  const url     = "$httpBean.url";
  const method  = "$httpBean.method";
  const body    = "$httpBean.body";
  const headers = {
#foreach( $hKey in $httpBean.headers.keySet() )
    "$hKey": "$httpBean.headers.get($hKey)",
#end
  };

  const options = { method, headers };
  if (body && method !== "GET" && method !== "HEAD") {
    options.body = body;
  }

  fetch(url, options)
    .then(response => {
      console.log("<< Status: " + response.status + " " + response.statusText);
      return response.text();
    })
    .then(text => console.log(text))
    .catch(err  => console.error(err));
</script>