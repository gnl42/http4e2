"""
  This is a Python HTTP client generated by HTTP4e2,
  based on the Python 3 standard library http.client.
"""
import http.client
from urllib.parse import urlparse

method = "$httpBean.method"
url    = "$httpBean.protocol://$httpBean.domain:$httpBean.nonullPort$httpBean.path"
body   = "$httpBean.body"
headers = {
#foreach( $hKey in $httpBean.headers.keySet() )
    "$hKey": "$httpBean.headers.get($hKey)",
#end
}

parsed = urlparse(url)
path   = parsed.path
if parsed.query:
    path += "?" + parsed.query

if parsed.scheme == "https":
    conn = http.client.HTTPSConnection(parsed.hostname, parsed.port)
else:
    conn = http.client.HTTPConnection(parsed.hostname, parsed.port)

conn.request(method.upper(), path, body if method.upper() not in ("GET", "HEAD") else None, headers)
response = conn.getresponse()
print(f"<< Status: {response.status} {response.reason}")
print(response.read().decode("utf-8"))
conn.close()