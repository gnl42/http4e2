Imports System
Imports System.Net.Http
Imports System.Text
Imports System.Threading.Tasks

'
' This is a sample VisualBasic.NET HTTP REST client generated by HTTP4e2,
' based on .NET HttpClient.
'
Public Class HTTP4e2

    Public Shared Async Function Main(ByVal args As String()) As Task

        Dim url    As String = "$httpBean.url"
        Dim method As String = "$httpBean.method"
        Dim body   As String = "$httpBean.body"

        Using client As New HttpClient()
#foreach( $hKey in $httpBean.headers.keySet() )
            client.DefaultRequestHeaders.TryAddWithoutValidation("$hKey", "$httpBean.headers.get($hKey)")
#end
            Dim request As New HttpRequestMessage(New HttpMethod(method), url)
            If Not String.IsNullOrEmpty(body) AndAlso method <> "GET" AndAlso method <> "HEAD" Then
                request.Content = New StringContent(body, Encoding.UTF8, "application/json")
            End If

            Dim response As HttpResponseMessage = Await client.SendAsync(request)
            Console.WriteLine($"<< Status: {CInt(response.StatusCode)} {response.ReasonPhrase}")
            Dim content As String = Await response.Content.ReadAsStringAsync()
            Console.WriteLine(content)
        End Using

    End Function

End Class