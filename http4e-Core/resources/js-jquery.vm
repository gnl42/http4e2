<script src="https://code.jquery.com/jquery-3.7.1.min.js"
        integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
        crossorigin="anonymous"></script>

<script>
  /*
   * This is a sample jQuery HTTP REST client generated by HTTP4e2.
   */
  const url      = "$httpBean.url";
  const method   = "$httpBean.method";
  const data     = "$httpBean.body";
  const dataType = "text"; // "xml", "html", "json", "jsonp", "text"
  const headers  = {};
#foreach( $hKey in $httpBean.headers.keySet() )
  headers["$hKey"] = "$httpBean.headers.get($hKey)";
#end

  $.ajax({
    type:       method,
    url:        url,
    data:       data,
    dataType:   dataType,
    headers:    headers,
    cache:      false,
    success: function(responseData, status, xhr) {
      console.log("<< Status: " + xhr.status + " " + xhr.statusText);
      console.log(responseData);
    },
    error: function(xhr) {
      console.error("<< Status: " + xhr.status + " " + xhr.statusText);
      console.error(xhr.responseText);
    }
  });
</script>