/*
  This is a Cocoa HTTP client generated by HTTP4e2,
  based on NSURLSession.
 */
NSString *urlString = [NSString stringWithFormat:@"%@%@",
    @"$httpBean.urlNoQuery", @"$httpBean.queryTerm"];
NSURL *url = [NSURL URLWithString:urlString];
NSMutableURLRequest *req = [NSMutableURLRequest requestWithURL:url];
[req setHTTPMethod:@"GET"];
#foreach( $hKey in $httpBean.headers.keySet() )
[req setValue:@"$httpBean.headers.get($hKey)" forHTTPHeaderField:@"$hKey"];
#end

NSURLSessionDataTask *task =
    [[NSURLSession sharedSession] dataTaskWithRequest:req
        completionHandler:^(NSData *data, NSURLResponse *response, NSError *error) {
    if (error) { NSLog(@"Error: %@", error); return; }
    NSHTTPURLResponse *http = (NSHTTPURLResponse *)response;
    NSLog(@"<< Status: %ld %@", (long)http.statusCode,
          [NSHTTPURLResponse localizedStringForStatusCode:http.statusCode]);
    if (data) {
        NSString *result = [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding];
        NSLog(@"%@", result);
    }
}];
[task resume];