import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.time.Duration;

/**
 * This is a Java HTTP Rest client generated by HTTP4e2,
 * based on the Java 21 built-in java.net.http.HttpClient.
 */
public class HTTP4e2 {

   public static void main(String[] args) throws Exception {

      HttpClient client = HttpClient.newBuilder()
            .version(HttpClient.Version.HTTP_2)
            .connectTimeout(Duration.ofSeconds(10))
            .build();

      String url = "$httpBean.protocol://$httpBean.domain:$httpBean.nonullPort$httpBean.path";

      HttpRequest.Builder requestBuilder = HttpRequest.newBuilder()
            .uri(URI.create(url))
            .timeout(Duration.ofSeconds(30));

#foreach( $hKey in $httpBean.headers.keySet() )
      requestBuilder.header("$hKey", "$httpBean.headers.get($hKey)");
#end

#if ($httpBean.method == "GET")
      requestBuilder.GET();
#elseif ($httpBean.method == "POST")
      requestBuilder.POST(HttpRequest.BodyPublishers.ofString("$httpBean.body"));
#elseif ($httpBean.method == "PUT")
      requestBuilder.PUT(HttpRequest.BodyPublishers.ofString("$httpBean.body"));
#elseif ($httpBean.method == "DELETE")
      requestBuilder.DELETE();
#elseif ($httpBean.method == "HEAD")
      requestBuilder.method("HEAD", HttpRequest.BodyPublishers.noBody());
#elseif ($httpBean.method == "OPTIONS")
      requestBuilder.method("OPTIONS", HttpRequest.BodyPublishers.noBody());
#elseif ($httpBean.method == "PATCH")
      requestBuilder.method("PATCH", HttpRequest.BodyPublishers.ofString("$httpBean.body"));
#else
      requestBuilder.method("$httpBean.method", HttpRequest.BodyPublishers.noBody());
#end

      HttpRequest request = requestBuilder.build();

      HttpResponse<String> response = client.send(request, HttpResponse.BodyHandlers.ofString());

      System.out.println("<< Status: " + response.statusCode());
      System.out.println(response.body());
   }
}
